<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Student</title>
    <link rel="stylesheet" href="/style.css"/>
</head>

<body>
    <div class="container">
        <h2>Add Student Marks</h2>

        <% if (typeof message !== "undefined") {%>
            <p class="message">
                <%= message %>
            </p>
        <% } %>

        <form action="/students/add" method="post">
            <label>Student Name</label>
            <input name="name" placeholder="e.g. Ramesh Kumar" required />

            <label>Math Marks (Out of 100)</label>
            <input type="number" name="maths" min="0" max="100" value="50" required />

            <label>Science Marks (Out of 100)</label>
            <input type="number" name="science" min="0" max="100" value="50" required />

            <label>English Marks (Out of 100)</label>
            <input type="number" name="english" min="0" max="100" value="50" required />

            <button type="submit">Generate Report Card</button>
        </form>
        <br />
        <a href="/">Go to Home</a>
    </div>

</body>

</html>